#!/usr/bin/env bash
# A local Supabase for the check, so browser tests do not wait on the shared cloud database.
# The live site and `pnpm dev` keep using the cloud project from .env.local.
#   scripts/local-db up     start it (Docker), apply db/bootstrap.sql, write local-db.vars
#   scripts/local-db down   stop it and remove local-db.vars
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

VARS_FILE="local-db.vars"
EXCLUDED="studio,imgproxy,mailpit,inbucket,edge-runtime,logflare,vector,realtime,storage-api,postgres-meta,supavisor"
SUPABASE=(pnpm dlx supabase@2)

case "${1:-}" in
  up)
    "${SUPABASE[@]}" start -x "$EXCLUDED"
    "${SUPABASE[@]}" db reset --no-seed >/dev/null 2>&1 || true
    docker exec -i "supabase_db_technoverse-project" psql -q -U postgres -d postgres < db/bootstrap.sql
    status=$("${SUPABASE[@]}" status -o env)
    value() { printf '%s\n' "$status" | sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p"; }
    {
      echo "NEXT_PUBLIC_SUPABASE_URL=$(value API_URL)"
      echo "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$(value ANON_KEY)"
      echo "SUPABASE_SECRET_KEY=$(value SERVICE_ROLE_KEY)"
      echo "DEMO_EMAIL=demo@imtihaan.test"
      echo "DEMO_PASSWORD=local-demo-pass"
    } > "$VARS_FILE"
    echo "local-db: running. scripts/check now uses it; scripts/local-db down to go back to the cloud database."
    ;;
  down)
    "${SUPABASE[@]}" stop
    rm -f "$VARS_FILE"
    echo "local-db: stopped. scripts/check uses the cloud database again."
    ;;
  *)
    echo "Usage: scripts/local-db up | down" >&2
    exit 1
    ;;
esac
