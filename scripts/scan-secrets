#!/usr/bin/env bash
# Blocks a commit that stages an env file, a key file or a secret-looking string.
# Runs from the pre-commit hook on every machine, whoever makes the commit.
# A false alarm is waved through by putting hack:allow-secret on that line.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ALLOW_MARK='hack:allow-secret'
LOCAL_HOSTS='@(localhost|127\.0\.0\.1|0\.0\.0\.0|db|database|postgres|mysql|mongo|redis|host\.docker\.internal)([:/?]|$)'

# name|pattern  (extended regular expressions, matched against added lines only)
PATTERNS=(
  'a private key|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'an Anthropic key|sk-ant-[A-Za-z0-9_-]{20,}'
  'an OpenAI-style key|sk-(proj-)?[A-Za-z0-9_-]{32,}'
  'an AWS access key|AKIA[0-9A-Z]{16}'
  'a GitHub token|(gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})'
  'a Slack token|xox[baprs]-[A-Za-z0-9-]{10,}'
  'a Stripe key|(sk|rk)_(live|test)_[A-Za-z0-9]{16,}'
  'a Google API key|AIza[0-9A-Za-z_-]{35}'
  'a signed token (JWT), such as a Supabase key|eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{15,}'
)
DATABASE_URL='(postgres(ql)?|mysql|mongodb(\+srv)?|rediss?|amqps?)://[^:@/[:space:]]+:[^@/[:space:]]{4,}@'
ASSIGNED_SECRET='(api[_-]?key|secret|token|passw(or)?d)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_/+=.-]{24,}["'"'"']'

findings=()

while IFS= read -r -d '' file; do
  case "${file##*/}" in
    .env.example | .env.sample | .env.template) ;;
    .env | .env.* | *.pem | *.p12 | *.keystore | id_rsa | id_ed25519 | settings.local.json)
      findings+=("$file: this file must never be committed")
      continue
      ;;
  esac
  case "$file" in
    scripts/scan-secrets | *.lock | *package-lock.json | *pnpm-lock.yaml) continue ;;
  esac

  added=$(git diff --cached -U0 --no-color -- "$file" | grep -E '^\+' | grep -vE '^\+\+\+' | grep -vF "$ALLOW_MARK" || true)
  [ -n "$added" ] || continue

  for entry in "${PATTERNS[@]}"; do
    if printf '%s\n' "$added" | grep -qE -- "${entry#*|}"; then
      findings+=("$file: looks like ${entry%%|*}")
    fi
  done
  if printf '%s\n' "$added" | grep -E -- "$DATABASE_URL" | grep -qvE -- "$LOCAL_HOSTS"; then
    findings+=("$file: looks like a database address with its password")
  fi
  if printf '%s\n' "$added" | grep -qiE -- "$ASSIGNED_SECRET"; then
    findings+=("$file: looks like a secret written into the code")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ "${#findings[@]}" -gt 0 ] || exit 0

echo "Commit blocked: a secret or an env file is staged."
printf '  %s\n' "${findings[@]}"
echo "Put the value in .env, which is never committed, and read it from the environment."
echo "If it is a false alarm, add the comment $ALLOW_MARK on that line and commit again."
exit 1
