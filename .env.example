# Names only. Real values go in .env.local, which is never committed.
# Add a line here in the same change that introduces a new variable.

# When on (1), outside services answer from recorded responses.
DEMO_MODE=

# Supabase project: Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The one-click demo account. Use an address on a real-looking domain.
# The password: 8 or more letters and digits. A #, $, quote or space can be cut off by this file's format.
DEMO_EMAIL=
DEMO_PASSWORD=
ANTHROPIC_API_KEY=
